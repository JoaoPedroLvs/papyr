<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 splash; 12+ uses the system splash from values-v31. Same layout as 12+:
     the mark at 136 dp in the center and the name in a 200x80 dp frame 60 dp from the bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/splash_mark"
        android:gravity="center" />
    <item
        android:width="200dp"
        android:height="80dp"
        android:bottom="60dp"
        android:drawable="@drawable/splash_branding"
        android:gravity="bottom|center_horizontal" />
</layer-list>
