<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash. The animated icon makes the system draw the mark
         at full size instead of a blurry bitmap of the launcher foreground. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
    </style>
</resources>
